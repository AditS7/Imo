# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# LLM Inference Providers (At least one required)
# Groq is recommended for ultra-fast response times:
GROQ_API_KEY=your_groq_api_key_here
# OpenRouter / OpenAI compatible fallback or alternative:
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tavily API Key for Live Web & Kingshot Guide Search (Required for real-time web search)
TAVILY_API_KEY=your_tavily_api_key_here

# AI Model Configuration
MODEL_NAME=qwen/qwen3.8-27b

# Spontaneous Chat Reply Settings
SPONTANEOUS_REPLY_ENABLED=true
SPONTANEOUS_REPLY_CHANCE=0.10
SPONTANEOUS_COOLDOWN_SECONDS=60

# Context Memory Settings
MAX_HISTORY_MESSAGES=3

# Kingdom 2403 Announcement Channel (Optional - can also be set via /set_kingdom_channel in Discord)
# KINGDOM_CHANNEL_ID=123456789012345678
